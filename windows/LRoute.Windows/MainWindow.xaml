<Window x:Class="LRoute.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LRoute" Width="1180" Height="760" MinWidth="940" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#101113" Foreground="#F5F5F5"
 FontFamily="Segoe UI" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#191B1F"/>
  <SolidColorBrush x:Key="Panel2" Color="#202329"/>
  <SolidColorBrush x:Key="Line" Color="#30343B"/>
  <SolidColorBrush x:Key="Muted" Color="#9299A4"/>
  <SolidColorBrush x:Key="Accent" Color="#F28A35"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F8F8F8"/><Setter Property="Background" Value="#282C33"/>
   <Setter Property="BorderBrush" Value="#3A4049"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#343943"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="#202329"/><Setter Property="BorderBrush" Value="#30343B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#191B1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="16" Padding="18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Grid Margin="0,2,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="12" Background="#F28A35"><TextBlock Text="L" FontSize="24" FontWeight="Bold" Foreground="#101113" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="LROUTE" FontSize="20" FontWeight="Bold"/><TextBlock Text="SECURE NETWORK" FontSize="9" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="•••" Padding="10,5" Background="Transparent" Click="Menu_Click"/>
     </Grid>
     <TextBlock Text="CONNECTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="2,0,0,10"/>
     <Border Background="#202329" BorderBrush="#343942" BorderThickness="1" CornerRadius="12" Padding="14">
      <StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#777F89" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Disconnected" FontWeight="SemiBold"/></StackPanel>
       <TextBlock x:Name="DeviceText" Text="lroute-desktop" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
       <TextBlock x:Name="EndpointText" Text="No active profile" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
     </Border>
     <Button x:Name="ConnectButton" Content="Connect" Background="#F28A35" BorderBrush="#F28A35" Foreground="#171717" Margin="0,14,0,0" Click="Connect_Click"/>
     <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="2,28,0,10"/>
     <Button Content="⌂   Overview" HorizontalContentAlignment="Left" Background="#2A2E35" BorderBrush="#2A2E35" Margin="0,0,0,6" Click="Overview_Click"/>
     <Button Content="◈   Profiles" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Profiles_Click"/>
     <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Settings_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14"/>
     <TextBlock Text="LRoute for Windows" Foreground="{StaticResource Muted}" FontSize="11"/>
     <TextBlock Text="Xray-based • WireGuard excluded" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="2,3,2,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Route WinINET-aware apps through your selected Xray profile." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋ Import profile" Click="Import_Click" Background="#F28A35" BorderBrush="#F28A35" Foreground="#171717"/><Button Content="Refresh subscription" Margin="8,0,0,0" Click="RefreshSubscription_Click"/><Button Content="Export selected" Margin="8,0,0,0" Click="Export_Click"/><Button Content="Manual config" Margin="8,0,0,0" Click="Manual_Click"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="#191B1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="PROFILES" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="Bold"/><TextBlock x:Name="ProfileCount" Text="0 saved profiles" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
     <Border Grid.Column="1" Background="#191B1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="12,0,0,0"><StackPanel><TextBlock Text="ENGINE" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="Bold"/><TextBlock x:Name="EngineState" Text="Stopped" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="1" Background="#191B1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="14" Padding="16">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your profiles" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Choose a profile to connect with Xray-core." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Validate selected" Click="ValidateSelected_Click" Margin="0,0,8,0"/><Button Content="Remove selected" Click="Remove_Click"/></StackPanel></Grid>
      <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged">
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayEndpoint}" Foreground="#A0A7B1" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#30343B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding ProtocolLabel}" FontSize="10" FontWeight="Bold" Foreground="#F5A15D"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>