<Window x:Class="LRoute.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LRoute" Height="760" Width="1180" MinHeight="560" MinWidth="860"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
 Foreground="{StaticResource ForegroundBrush}" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#D8D8D8"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,2,0,2"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="LROUTE" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="WINDOWS EDITION" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,4,0,32"/>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Button Content="⌂   Dashboard" Style="{StaticResource NavButton}" />
     <Button Content="▤   Profiles" Style="{StaticResource NavButton}" />
     <Button Content="⚙   Settings" Style="{StaticResource NavButton}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
     <TextBlock Text="ENGINE STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
     <TextBlock x:Name="EngineStatus" Text="Xray-core runtime initializing" Margin="0,7,0,0" FontSize="13"/>
     <TextBlock Text="Xray-core • VLESS / VMess / Trojan / Shadowsocks JSON" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
     <TextBlock Text="LRoute • Windows x64" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,24,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Manage VPN profiles and connection settings." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#171717" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="12,7">
     <TextBlock x:Name="ConnectionStatus" Text="●  DISCONNECTED" FontSize="10" FontWeight="Bold"/>
    </Border>
   </Grid>
   <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,28,0,22">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="CONNECTION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
      <TextBlock x:Name="ConnectionMessage" Text="Select an Xray JSON profile to start the engine." FontSize="22" FontWeight="SemiBold" Margin="0,9,0,4"/>
      <TextBlock Text="Xray-core local proxy engine • no system-wide TUN yet" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
     </StackPanel>
     <Button x:Name="ConnectButton" Grid.Column="1" Content="CONNECT" IsEnabled="False" Click="ConnectButton_Click" Width="142" Height="44" Background="#FFFFFF" Foreground="#080808" BorderThickness="0" FontWeight="Bold" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Your profiles" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="WireGuard, AmneziaWG, VLESS, VMess, Trojan and Shadowsocks" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
     </StackPanel>
     <Button x:Name="ImportButton" Grid.Column="1" Content="+  IMPORT PROFILE" Width="160" Height="38" HorizontalAlignment="Right" Background="#FFFFFF" Foreground="#080808" BorderThickness="0" FontWeight="Bold" Click="ImportButton_Click"/>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" Padding="24">
     <Grid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock Text="◇" FontSize="38" HorizontalAlignment="Center" Foreground="#777777"/>
       <TextBlock Text="No profiles yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5"/>
       <TextBlock Text="Import a .conf or supported configuration file." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
       <Button Content="IMPORT CONFIGURATION" Click="ImportButton_Click" Margin="0,18,0,0" Padding="18,10" Background="#FFFFFF" Foreground="#080808" BorderThickness="0" FontWeight="Bold"/>
      </StackPanel>
      <ListView x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="White">
       <ListView.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
           <Button Grid.Column="1" Content="REMOVE" Tag="{Binding}" Click="RemoveProfile_Click" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,5" FontSize="10"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
