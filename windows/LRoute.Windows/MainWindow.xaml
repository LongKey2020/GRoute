<Window x:Class="LRoute.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LROUTE" Height="900" Width="760" MinHeight="720" MinWidth="620"
 WindowStartupLocation="CenterScreen" Background="#000000" Foreground="#FFFFFF"
 FontFamily="Segoe UI" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="OutlineAction" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#000000"/>
   <Setter Property="BorderBrush" Value="White"/>
   <Setter Property="BorderThickness" Value="2"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="16,10"/>
   <Setter Property="Height" Value="58"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="BottomNav" TargetType="Button">
   <Setter Property="Foreground" Value="#D0D0D0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="12,12"/>
  </Style>
 </Window.Resources>
 <Grid Background="#000000">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Width="640" MaxWidth="640" HorizontalAlignment="Center" Margin="24,12,24,22">
    <Grid Margin="0,0,0,34">
     <TextBlock Text="LROUTE" FontSize="34" CharacterSpacing="160" HorizontalAlignment="Center" FontWeight="Light"/>
     <TextBlock Text="◐" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
    </Grid>
    <Border Background="#171717" BorderBrush="#888888" BorderThickness="2" CornerRadius="20" Padding="22" Margin="0,0,0,26">
     <StackPanel>
      <Grid Margin="0,0,0,14">
       <TextBlock Text="Selected server" Foreground="#BDBDBD" FontSize="15" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Ellipse Width="13" Height="13" Fill="#BDBDBD" Margin="4,0"/>
        <Ellipse Width="13" Height="13" Fill="#BDBDBD" Margin="4,0"/>
        <Ellipse Width="13" Height="13" Fill="#BDBDBD" Margin="4,0"/>
       </StackPanel>
      </Grid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Select a server profile" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="Import a config file or choose a saved profile" Foreground="#BDBDBD" FontSize="15" Margin="0,8,0,0"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="›" FontSize="38" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
     </StackPanel>
    </Border>
    <Button Content="VPN SETTINGS  ·  DNS / SPLIT TUNNEL" Style="{StaticResource OutlineAction}" Margin="0,0,0,26"/>
    <Grid Margin="0,0,0,26">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Content="MANUAL CONFIG" Style="{StaticResource OutlineAction}" Margin="0,0,9,0"/>
     <Button Grid.Column="1" Content="SCAN QR" Style="{StaticResource OutlineAction}" Margin="9,0,0,0"/>
    </Grid>
    <Button x:Name="ImportButton" Content="IMPORT CONFIG FILE" Style="{StaticResource OutlineAction}" Click="ImportButton_Click" Margin="0,0,0,26"/>
    <Button x:Name="ConnectButton" Content="CONNECT" IsEnabled="False" Click="ConnectButton_Click"
     Height="100" Background="#343434" Foreground="White" BorderBrush="#AAAAAA" BorderThickness="2"
     FontSize="24" FontWeight="Bold" Margin="0,0,0,26">
     <Button.Template>
      <ControlTemplate TargetType="Button">
       <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="34">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </ControlTemplate>
     </Button.Template>
    </Button>
    <Grid Margin="0,0,0,26">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#171717" BorderBrush="#888888" BorderThickness="1.5" CornerRadius="22" Padding="16" Margin="0,0,8,0">
      <StackPanel><TextBlock Text="↓ 0 B/s" FontSize="18"/><TextBlock Text="0 B" Foreground="#BBBBBB" FontSize="14" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="1" Background="#171717" BorderBrush="#888888" BorderThickness="1.5" CornerRadius="22" Padding="16" Margin="8,0">
      <StackPanel><TextBlock Text="↑ 0 B/s" FontSize="18"/><TextBlock Text="0 B" Foreground="#BBBBBB" FontSize="14" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Button Grid.Column="2" Content="◉" FontSize="28" Background="#000000" Foreground="White" BorderBrush="White" BorderThickness="2" Margin="8,0,0,0"/>
    </Grid>
    <Border Width="210" Height="210" CornerRadius="105" BorderBrush="#505050" BorderThickness="2" Background="#101820" HorizontalAlignment="Center" Margin="0,0,0,22">
     <Grid>
      <Ellipse Width="170" Height="170" Stroke="#8A9AA8" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="◎" FontSize="112" Foreground="#BFC8D0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Border Background="#10271F" BorderBrush="#247A55" BorderThickness="1.5" CornerRadius="28" Padding="18,10" HorizontalAlignment="Center" Margin="0,0,0,24">
     <TextBlock Text="● DISCONNECTED" Foreground="#56DCA6" FontSize="22" FontWeight="Medium"/>
    </Border>
    <TextBlock Text="YOUR PROFILES" FontSize="13" Foreground="#AAAAAA" FontWeight="Bold" Margin="0,0,0,12"/>
    <Border Background="#111111" BorderBrush="#444444" BorderThickness="1" CornerRadius="16" Padding="12">
     <Grid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="8">
       <TextBlock Text="No profiles imported" FontSize="16" Foreground="#BBBBBB"/>
      </StackPanel>
      <ListView x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged"
       Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="White">
       <ListView.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Type}" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0"/></StackPanel>
           <Button Grid.Column="1" Content="REMOVE" Tag="{Binding}" Click="RemoveProfile_Click" Background="Transparent" Foreground="#BBBBBB" BorderBrush="#666666" Padding="10,5"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="#171717">
   <Grid Width="640" HorizontalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="▣\nSSH" Style="{StaticResource BottomNav}"/>
    <Button Grid.Column="1" Content="⌂\nHome" Style="{StaticResource BottomNav}" Background="#202020" Foreground="White"/>
    <Button Grid.Column="2" Content="▦\nDebugger" Style="{StaticResource BottomNav}"/>
    <Button Grid.Column="3" Content="⚙\nSettings" Style="{StaticResource BottomNav}"/>
   </Grid>
  </Border>
 </Grid>
</Window>